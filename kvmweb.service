[Unit]
Description=KVM web (HDMI capture + H.264 + API + terminal proxy) cong 8090
After=network.target hidfwd.service usb-kvm-gadget.service

[Service]
WorkingDirectory=/home/sang/Run/kvm
ExecStart=/usr/bin/python3 /home/sang/Run/kvm/kvmweb.py --port 8090
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
